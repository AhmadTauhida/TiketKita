PORT=3000
NODE_ENV=development

# Runtime: Supabase connection pooler (transaction mode)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true"
# Migrasi dan tes: direct connection atau session pooler
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres"

JWT_SECRET="ganti_dengan_string_acak_minimal_32_karakter"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS=10
BOOKING_EXPIRY_MINUTES=15
CORS_ORIGIN="*"

# Storage media (upload foto profil/poster). Gunakan memory untuk lokal tanpa bucket nyata.
# Produksi dan verifikasi bucket wajib memakai supabase.
STORAGE_DRIVER="memory"
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# Utamakan secret key baru (sb_secret_...). Kunci server-side, jangan expose ke client.
SUPABASE_SECRET_KEY="sb_secret_<SECRET_KEY>"
# Fallback legacy sampai awal 2027:
# SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"
SUPABASE_MEDIA_BUCKET="media"
